# Copy to .env and change what you need. git pull does not touch .env.
# Lines starting with # keep the default.

# NPM log folder on this server
# NPM in Docker:     /opt/data/logs (or wherever its /data volume is)
# NPM without Docker: /data/logs
NPM_LOGS=/opt/data/logs

#TZ=Europe/Berlin
#INTERVAL=60        # seconds between two log reads
#DETAIL_DAYS=90     # days that files and visitor IPs are kept
#CLEAR=on           # allow deleting a domain's data in the UI
#GEOIP=on           # countries (DB-IP, downloaded monthly)
#ASN=on             # providers (DB-IP, downloaded monthly)
#UPDATE_CHECK=on    # ask GitHub for new versions
