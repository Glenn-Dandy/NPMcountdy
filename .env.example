# Copy to .env. git pull does not touch .env. All other settings are on the settings page.

# NPM log folder on this server
# NPM in Docker:      /opt/data/logs (or wherever its /data volume is, + /logs)
# NPM without Docker: /data/logs
NPM_LOGS=/opt/data/logs

# Deleting a domain's data in the UI, "off" turns it off
#CLEAR=on
